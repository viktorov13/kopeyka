# Docker Compose без .env запускает панель в режиме rules.
# Скопируйте файл в .env, заполните токен и LLM_MODEL для полноценного ИИ-бота.
PORT=8080
APP_TIMEZONE=Europe/Moscow

# Токен от @BotFather. Пустое значение отключает только Telegram.
TELEGRAM_BOT_TOKEN=

# llm — ИИ-агент; rules — демонстрационный разбор ограниченного набора фраз.
BOT_MODE=llm
# Базовый URL API без /chat/completions. Поддерживается Chat Completions + tools.
LLM_BASE_URL=https://api.openai.com/v1
# Для OpenAI заполните API-ключ. Локальный провайдер может не требовать ключа.
LLM_API_KEY=
# Обязательно для режима llm: точное имя доступной модели с function calling.
# Модели, поддерживающие tools только через Responses API, не подходят.
LLM_MODEL=
LLM_TIMEOUT=20s
LLM_MAX_STEPS=6
# Необязательный режим reasoning; для Ollama/Qwen3 задайте none.
LLM_REASONING_EFFORT=
