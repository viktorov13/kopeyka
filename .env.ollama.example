# Локальная Ollama на macOS; Go-приложение и PostgreSQL — в Docker Desktop.
# cp .env.ollama.example .env
PORT=8080
APP_TIMEZONE=Europe/Moscow

# Вставьте новый токен из @BotFather; без него панель работает, Telegram отключён.
TELEGRAM_BOT_TOKEN=
BOT_MODE=llm
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
LLM_TIMEOUT=60s
LLM_MAX_STEPS=6
# Дополнительная настройка API; выбрана явная Instruct-модель без thinking.
LLM_REASONING_EFFORT=none
